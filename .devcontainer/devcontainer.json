{
  "name": "Jeevithaya MIT (Django)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "containerEnv": {
    "DB_ENGINE": "sqlite",
    "DJANGO_DEBUG": "True"
  },
  "postCreateCommand": "pip install -r requirements.txt && python manage.py migrate --noinput",
  "postAttachCommand": "python manage.py runserver 0.0.0.0:8000",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Django",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
